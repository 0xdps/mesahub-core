# SQLite Hub — Local Development Environment Variables
# Copy this file to .env and customize for your environment

# ── Authentication ───────────────────────────────────────────────────────────

# Admin panel authentication token (min 8 chars, preferably random)
# For testing: use any value, it's just for local dev
ADMIN_TOKEN=dev-token-change-me-in-production

# Session cookie signing secret (min 32 chars, must be random)
# Generate a new one for each environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-long-random-session-secret-key-change-in-production-at-least-32-chars

# ── Storage ──────────────────────────────────────────────────────────────────

# Data directory (must exist and be writable)
DATA_PATH=/data

# Maximum volume usage before blocking new databases (0-100 percent)
MAX_VOLUME_USAGE_PERCENT=85

# ── File Storage ─────────────────────────────────────────────────────────────

# Enable file storage feature
ENABLE_FILE_STORAGE=true

# Enable proxy-accelerated file downloads via X-Sendfile header
# When true: Files served directly by Caddy (fast)
# When false: Files streamed through Node.js (full auth control)
ENABLE_FILE_PROXY_DELIVERY=true

# Maximum file size (bytes): 100MB default
FILE_MAX_SIZE_BYTES=104857600

# Maximum files per database
FILE_MAX_FILES_PER_DB=10000

# Maximum storage per database (bytes): 5GB default
FILE_MAX_STORAGE_PER_DB_BYTES=5368709120

# Upload conflict behavior for same db_name + folder_path + filename
# replace: overwrite existing file at same path (default)
# error: reject with 409 if path already exists
FILE_UPLOAD_CONFLICT_MODE=replace

# Maximum file IDs accepted by bulk delete endpoint
FILE_BULK_DELETE_MAX_IDS=100

# Dedicated signing secret for presigned file URLs.
# Required in production.
FILE_URL_SIGNING_SECRET=your-long-random-file-signing-secret

# Dedicated signing secret for file access tokens.
# Required in production.
FILE_TOKEN_SIGNING_SECRET=your-long-random-token-signing-secret

# CORS allowed origins for browser-based third-party integrations
# Comma-separated list, e.g. "https://app.example.com,https://admin.example.com"
# Use "*" for public APIs (avoid with credentials)
CORS_ALLOWED_ORIGINS=

# Internal-network bypass when DB has no service_secret (recommended: false)
ALLOW_INTERNAL_DB_ACCESS_WITHOUT_SECRET=false

# Default and max TTL for presigned file URLs (seconds)
FILE_PRESIGN_DEFAULT_TTL_SECONDS=900
FILE_PRESIGN_MAX_TTL_SECONDS=86400

# ── Query Execution ──────────────────────────────────────────────────────────

# Maximum SQL statement length (bytes)
MAX_SQL_LENGTH=100000

# Maximum SQL bindings per statement
MAX_SQL_BINDINGS=5000

# ── Node.js & Runtime ────────────────────────────────────────────────────────

# Node.js environment
NODE_ENV=development

# Next.js server port (internal, not exposed directly)
# Docker: set to 3000 (Caddy proxies on port 80)
# Local dev: set to 3000 (or change if port is in use)
PORT=3000

# Hostname binding ("::" binds to both IPv4 and IPv6)
# Required for Railway private networking (resolves to IPv6 first)
HOSTNAME=::

# ── Development & Debugging ──────────────────────────────────────────────────

# Debug logging
# DEBUG=sqlite-hub
# LOG_LEVEL=debug

# ── For Local Development (outside Docker) ────────────────────────────────────

# If running locally with `npm run dev`:
# - Keep PORT=3000
# - Change DATA_PATH to ./data (relative path OK)
# - No need for HOSTNAME (localhost is fine)

# ── For Docker Local Development ──────────────────────────────────────────────

# If running with docker-compose up:
# - Keep all defaults above
# - Data is persisted in docker volume (sqlite-hub-data)
# - Caddy proxies requests to Next.js on internal port 3000

# ── For Railway Production ────────────────────────────────────────────────────

# When deployed to Railway:
# - ADMIN_TOKEN: Set to a strong random value
# - SESSION_SECRET: Set to a strong random value (auto-gen recommended)
# - DATA_PATH: /data (persisted volume)
# - MAX_VOLUME_USAGE_PERCENT: 85 (tuned for your volume size)
# - Enable file storage if using file features
# - All others: use defaults

###############################################################################
# Examples
###############################################################################

# Generate a secure SESSION_SECRET:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# → 7a9d3f8b1c6e2a4f9d7c3b8e1a5f9c2d6e4a1b8f3c7d2a5e9b1f4c8a3d6e

# For 10GB file storage across all databases:
# FILE_MAX_STORAGE_PER_DB_BYTES=10737418240

# For 1MB max file size (smaller uploads):
# FILE_MAX_SIZE_BYTES=1048576
