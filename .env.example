# Directory where .db files are stored; mount a Railway volume here in production
DATA_PATH=/tmp/sqlite-db-hub-data

# Token required to log in to the dashboard and call any API endpoint
ADMIN_TOKEN=your-secret-token-here

# Signing secret for encrypted session cookies — minimum 32 characters
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars!!

# Block new database creation once the volume exceeds this usage % (default: 85)
MAX_VOLUME_USAGE_PERCENT=85
