# SQLite Hub — Environment Variables
#
# Only two variables MUST be set to run. Everything else has a safe default.
#
# Generate secrets:
#   openssl rand -hex 32

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# REQUIRED — no defaults, must be set in every environment
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Admin API + dashboard auth token (min 8 chars).
# Also used as fallback signing key for file URLs and tokens when the dedicated
# secrets below are not set — so use a strong value regardless.
ADMIN_TOKEN=

# Iron-session cookie signing key — must be at least 32 chars.
SESSION_SECRET=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# OPTIONAL — good defaults, change only when you need different behaviour
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ── Runtime ──────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3000
# "::" binds to both IPv4 and IPv6 — required for Railway private networking.
HOSTNAME=::

# ── Storage ──────────────────────────────────────────────────────────────────

# Persistent volume mount path. Must be writable.
DATA_PATH=/data

# Block new database creation above this volume usage threshold (0–100).
MAX_VOLUME_USAGE_PERCENT=85

# ── File storage ─────────────────────────────────────────────────────────────

ENABLE_FILE_STORAGE=false

# Caddy X-Sendfile acceleration for downloads (faster; requires Caddy in front).
# Set false if running Next.js directly without Caddy.
ENABLE_FILE_PROXY_DELIVERY=true

# Per-file size limit (bytes). Default: 100 MB.
FILE_MAX_SIZE_BYTES=104857600

# Per-database file count limit.
FILE_MAX_FILES_PER_DB=10000

# Per-database total storage limit (bytes). Default: 5 GB.
FILE_MAX_STORAGE_PER_DB_BYTES=5368709120

# What to do when a file is uploaded to an existing path:
#   replace — overwrite (default)
#   error   — reject with 409
FILE_UPLOAD_CONFLICT_MODE=replace

# Max file IDs per bulk-delete request.
FILE_BULK_DELETE_MAX_IDS=100

# Presigned URL default and max TTL (seconds). Default: 15 min / 24 h.
FILE_PRESIGN_DEFAULT_TTL_SECONDS=900
FILE_PRESIGN_MAX_TTL_SECONDS=86400

# Dedicated signing secrets for presigned URLs and file access tokens.
# When not set, both fall back to ADMIN_TOKEN.
# Set these in production to isolate signing keys from the admin token.
# FILE_URL_SIGNING_SECRET=
# FILE_TOKEN_SIGNING_SECRET=

# ── Security ─────────────────────────────────────────────────────────────────

# CORS allowed origins for cross-origin browser integrations.
# Comma-separated. Leave empty to disallow cross-origin requests.
CORS_ALLOWED_ORIGINS=


# ── Query limits ─────────────────────────────────────────────────────────────

MAX_SQL_LENGTH=100000
MAX_SQL_BINDINGS=5000

# ── Control plane integration ────────────────────────────────────────────────
# Only needed when pairing with the sqlite-hub-control service.
# Leave SQLITE_HUB_MODE=standalone for standalone deployments.

# Deployment mode: standalone | control
# standalone — runs as a self-contained API service (default)
# control    — paired with the control plane; enables PKCE, API key validation,
#              and the internal /api/internal/* callback routes
SQLITE_HUB_MODE=standalone

# Shared secret for the control→template internal callbacks (e.g. key revocation).
# Required when SQLITE_HUB_MODE=control. Must match CONTROL_PLANE_SECRET in control.
# Generate: openssl rand -hex 32
# CONTROL_PLANE_SECRET=

# Shared secret for the control database (database name is always "control").
# The template auto-creates this database on startup using this value.
# Required when SQLITE_HUB_MODE=control. Must match CONTROL_DB_SECRET in control.
# Generate: openssl rand -hex 16
# CONTROL_DB_SECRET=

# Public URL of this template service — used to seed the default instance row
# in the control database so the control plane can locate this service.
# Example: https://api.mesahub.app
# SQLITE_HUB_PUBLIC_URL=

# ── Cache ────────────────────────────────────────────────────────────────────
# Cache backend for sessions and API key lookups.
#
#   none      — JWT cookies only; every API key lookup hits SQLite (default
#               when REDIS_URL is unset). Safe for single-instance standalone.
#   redis     — Redis-backed sessions + API key cache (5-min TTL).
#               Required when SQLITE_HUB_MODE=control.
#   in-memory — Process-local map with TTL. No Redis required.
#               Data is lost on restart. Good for single-instance with Redis unavailable.
#   both      — In-memory L1 + Redis L2. Sub-ms reads, cross-instance consistency.
#               Best for multi-instance control-mode deployments.
#
# Automatically derived from REDIS_URL presence when unset.
# CACHE_MODE=

# Redis connection URL. Required when CACHE_MODE=redis or CACHE_MODE=both,
# and mandatory when SQLITE_HUB_MODE=control (PKCE state must survive restarts).
# REDIS_URL=redis://localhost:6379
