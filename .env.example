# Path where SQLite files are stored (Railway persistent volume mount point)
DATA_PATH=/tmp/file-db-data

# Admin token — used to authenticate to the dashboard and API
ADMIN_TOKEN=your-secret-token-here

# iron-session secret — must be at least 32 characters
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars!!

# Maximum volume usage before new DB creation is blocked (percent, default 85)
MAX_VOLUME_USAGE_PERCENT=85
